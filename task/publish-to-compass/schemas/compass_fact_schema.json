{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "compass-fact",
  "title": "Compass Fact Data",
  "description": "Schema for intermediate fact data files produced by the fact generator and consumed by the Compass publisher. Each file contains a facts array with one or more fact objects.",
  "type": "object",
  "required": ["facts"],
  "additionalProperties": false,
  "properties": {
    "facts": {
      "type": "array",
      "minItems": 1,
      "description": "Array of one or more facts to be published to Compass.",
      "items": {
        "type": "object",
        "required": ["factRef", "entityRef", "data"],
        "additionalProperties": false,
        "properties": {
          "factRef": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+:[A-Za-z0-9_-]+/[A-Za-z0-9_-]+$",
            "description": "Compass fact reference (e.g. abevalflow:default/mcp_secrets)."
          },
          "entityRef": {
            "type": "string",
            "description": "Compass entity reference."
          },
          "data": {
            "type": "object",
            "description": "Fact payload. Structure varies by fact type."
          }
        }
      }
    }
  }
}
