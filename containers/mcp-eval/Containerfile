# MCP server evaluation image.
#
# Single image for the full MCP evaluation pipeline: static analysis,
# deterministic conformance testing, and behavioral evaluation (mcpchecker).
#
# Layers on top of the agent-eval-harness base image which provides:
#   - full abevalflow library (gates, schemas, observability, mcp, reports)
#   - Python 3.12, Node.js, npm, git, tar
#   - pyyaml (pip)
#
# This image adds:
#   - Helm CLI for MCP server deployment
#   - mcpchecker binary (from mcpchecker-runner)
#   - scanning tools: gitleaks, semgrep, licensee
#   - extra Python deps: pydantic, httpx
#   - envsubst for runtime MCP_URL injection
#   - MCP eval and Compass fact scripts, schemas, job templates, and suites
#
# Build from repo root (COPY needs repo-root context):
#   podman build -t quay.io/ecosystem-appeng/konflux-skill-evaluation/abevalflow-mcp-eval:0.1 \
#     -f containers/mcp-eval/Containerfile .

# ── Stage 1: mcpchecker-runner (source for mcpchecker binary) ──
FROM quay.io/ecosystem-appeng/mcpchecker-runner:latest AS mcpchecker-runner

# ── Stage 2: Runtime image (agent-eval-harness provides abevalflow + Node.js + pyyaml) ──
FROM quay.io/ecosystem-appeng/agent-eval-harness:v1.2.7

ARG HELM_VERSION=3.16.3
ARG GITLEAKS_VERSION=8.30.0
ARG SEMGREP_VERSION=1.179.0
ARG LICENSEE_VERSION=9.18.0
ARG PYDANTIC_VERSION=2.13.5
ARG HTTPX_VERSION=0.28.1

USER 0

# Copy mcpchecker binary from mcpchecker-runner
COPY --from=mcpchecker-runner /usr/local/bin/mcpchecker /usr/local/bin/mcpchecker
RUN chmod +x /usr/local/bin/mcpchecker

# MCP eval tasks — organized by task name as Python packages
# Directory names use underscores (Python requirement), Tekton task metadata.name uses hyphens.
# Tasks derive their directory via: TASK_MODULE="${TASK_NAME//-/_}" where TASK_NAME=$(context.task.name)
# This allows zero hardcoding while maintaining proper Python package structure.

# mcp-static-eval → mcp_static_eval
COPY task/mcp-static-eval/__init__.py /opt/mcp_static_eval/__init__.py
COPY task/mcp-static-eval/scripts     /opt/mcp_static_eval/scripts

# mcp-conformance-eval → mcp_conformance_eval
COPY task/mcp-conformance-eval/__init__.py /opt/mcp_conformance_eval/__init__.py
COPY task/mcp-conformance-eval/scripts     /opt/mcp_conformance_eval/scripts
COPY task/mcp-conformance-eval/templates   /opt/mcp_conformance_eval/templates

# mcp-behavioral-eval → mcp_behavioral_eval
COPY task/mcp-behavioral-eval/__init__.py /opt/mcp_behavioral_eval/__init__.py
COPY task/mcp-behavioral-eval/scripts     /opt/mcp_behavioral_eval/scripts
COPY task/mcp-behavioral-eval/suites      /opt/mcp_behavioral_eval/suites
COPY task/mcp-behavioral-eval/templates   /opt/mcp_behavioral_eval/templates

# generate-compass-facts → generate_compass_facts
COPY task/generate-compass-facts/__init__.py /opt/generate_compass_facts/__init__.py
COPY task/generate-compass-facts/scripts     /opt/generate_compass_facts/scripts
COPY task/generate-compass-facts/schemas     /opt/generate_compass_facts/schemas

# publish-to-compass → publish_to_compass
COPY task/publish-to-compass/__init__.py /opt/publish_to_compass/__init__.py
COPY task/publish-to-compass/scripts     /opt/publish_to_compass/scripts
COPY task/publish-to-compass/schemas     /opt/publish_to_compass/schemas
COPY task/publish-to-compass/templates   /opt/publish_to_compass/templates

# publish-to-db writer
COPY task/publish-to-db/scripts/store_mcp_results.py /opt/publish_to_db/scripts/store_mcp_results.py

# /opt for task packages, /opt/agent-eval-harness for abevalflow (from base image)
ENV PYTHONPATH=/opt:/opt/agent-eval-harness

# Scanning tools and extra Python deps not in the base image.
# nodejs, npm, pyyaml, git, tar are already provided by agent-eval-harness.
# licensee's native dep (rugged -> libgit2) needs a build toolchain to compile;
# install it, build the gem, then drop the toolchain to keep the image lean.
RUN curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz" \
      | tar -xz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
 && dnf install -y gettext --nodocs \
 && curl -LsSf \
      "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
      | tar -xz -C /usr/local/bin gitleaks \
 && pip install --no-cache-dir \
      "semgrep==${SEMGREP_VERSION}" \
      "pydantic==${PYDANTIC_VERSION}" \
      "httpx==${HTTPX_VERSION}" \
 && dnf install -y ruby ruby-devel gcc gcc-c++ make cmake pkgconf-pkg-config openssl-devel \
 && gem install licensee -v "${LICENSEE_VERSION}" \
 && dnf remove -y ruby-devel gcc gcc-c++ make cmake pkgconf-pkg-config openssl-devel \
 && dnf clean all

USER 1001
WORKDIR /workspace
